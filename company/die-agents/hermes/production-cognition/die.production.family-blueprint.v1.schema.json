{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema_version","request_id","blueprint_id","task_id","mission_id","repository_sha","principal","seed","family","production","metadata_direction","qa_requirements","lineage","authority"],
  "properties":{
    "schema_version":{"const":"die.production.family-blueprint.v1"},
    "request_id":{"type":"string","pattern":"^COG-[A-Z0-9_-]{8,160}$"},
    "blueprint_id":{"type":"string","pattern":"^BP-PROD-[A-Z0-9_-]{8,160}$"},
    "task_id":{"type":"string","minLength":1,"maxLength":160},
    "mission_id":{"const":"M-001"},
    "repository_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "principal":{"type":"object","additionalProperties":false,"required":["principal_id","role"],"properties":{"principal_id":{"const":"die-lnx-division-001"},"role":{"const":"AUTHOR"}}},
    "seed":{"type":"object","additionalProperties":false,"required":["id","canonical_name","object_class","category_path","asset_tier","demand_status","demand_score"],"properties":{"id":{"pattern":"^SEED-\\d{6}$"},"canonical_name":{"type":"string","minLength":1,"maxLength":200},"object_class":{"type":"string","minLength":1,"maxLength":200},"category_path":{"type":"string","minLength":1,"maxLength":300},"asset_tier":{"const":"U1-raster"},"demand_status":{"enum":["validated_high","validated_medium"]},"demand_score":{"type":"number","minimum":0,"maximum":1}}},
    "family":{"type":"object","additionalProperties":false,"required":["family_id","family_thesis","buyer_persona","use_cases","commercial_use_hypothesis","evidence_status"],"properties":{"family_id":{"type":"string","pattern":"^FAM-PROD-[A-Z0-9_-]{3,120}$"},"family_thesis":{"type":"string","minLength":20,"maxLength":2000},"buyer_persona":{"type":"array","minItems":1,"maxItems":10,"uniqueItems":true,"items":{"type":"string","minLength":2,"maxLength":300}},"use_cases":{"type":"array","minItems":1,"maxItems":12,"uniqueItems":true,"items":{"type":"string","minLength":3,"maxLength":500}},"commercial_use_hypothesis":{"type":"string","minLength":20,"maxLength":1800},"evidence_status":{"const":"OBJECT_ATLAS_ONLY_HYPOTHESIS"}}},
    "production":{"type":"object","additionalProperties":false,"required":["asset_type","batch_size","engine","master_prompt","negative_constraints","semantic_variation_plan"],"properties":{"asset_type":{"const":"RASTER_IMAGE"},"batch_size":{"type":"integer","minimum":1,"maximum":4},"engine":{"const":"MUXIA/chatgpt-linux-a"},"master_prompt":{"type":"string","minLength":80,"maxLength":8000},"negative_constraints":{"type":"array","minItems":3,"maxItems":40,"uniqueItems":true,"items":{"type":"string","minLength":2,"maxLength":500}},"semantic_variation_plan":{"type":"array","minItems":1,"maxItems":4,"items":{"type":"object","additionalProperties":false,"required":["variation_id","dimension","instruction","commercial_rationale"],"properties":{"variation_id":{"type":"string","pattern":"^VAR-[A-Z0-9_-]{3,80}$"},"dimension":{"enum":["buyer_use_case","composition","place","state","commercial_intent"]},"instruction":{"type":"string","minLength":10,"maxLength":1000},"commercial_rationale":{"type":"string","minLength":10,"maxLength":1000}}}}}},
    "metadata_direction":{"type":"object","additionalProperties":false,"required":["title_direction","primary_keywords","category_direction"],"properties":{"title_direction":{"type":"string","minLength":10,"maxLength":600},"primary_keywords":{"type":"array","minItems":3,"maxItems":30,"uniqueItems":true,"items":{"type":"string","minLength":2,"maxLength":100}},"category_direction":{"type":"array","minItems":1,"maxItems":10,"uniqueItems":true,"items":{"type":"string","minLength":2,"maxLength":120}}}},
    "qa_requirements":{"type":"object","additionalProperties":false,"required":["required_checks","forbidden_elements"],"properties":{"required_checks":{"type":"array","minItems":3,"maxItems":30,"uniqueItems":true,"items":{"type":"string","minLength":3,"maxLength":400}},"forbidden_elements":{"type":"array","minItems":3,"maxItems":30,"uniqueItems":true,"items":{"type":"string","minLength":2,"maxLength":300}}}},
    "lineage":{"type":"object","additionalProperties":false,"required":["seed_snapshot_sha256","source_kind","external_market_evidence_claimed"],"properties":{"seed_snapshot_sha256":{"pattern":"^[0-9a-f]{64}$"},"source_kind":{"const":"OBJECT_ATLAS_SEED"},"external_market_evidence_claimed":{"const":false}}},
    "authority":{"type":"object","additionalProperties":false,"required":["effect","existing_production_authority_unchanged","submission_authorized","publication_authorized","spend_authorized"],"properties":{"effect":{"const":"NONE"},"existing_production_authority_unchanged":{"const":true},"submission_authorized":{"const":false},"publication_authorized":{"const":false},"spend_authorized":{"const":false}}}
  }
}
