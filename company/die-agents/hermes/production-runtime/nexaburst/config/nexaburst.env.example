# Copy to /home/kopiko/.config/die/nexaburst.env on H01.
# Never commit actual values.
NEXABURST_NOTIFY_ENABLED=true
NEXABURST_TELEGRAM_BOT_TOKEN=
NEXABURST_TELEGRAM_CHAT_ID=
NEXABURST_NOTIFY_ON_SESSION_READY=true
NEXABURST_NOTIFY_ON_AUTH_OK=true
NEXABURST_NOTIFY_ON_JOB_FAILED=true
NEXABURST_NOTIFY_ON_STORAGE_GATE=true
NEXABURST_NOTIFY_ON_BATCH_SUMMARY=true
NEXABURST_NOTIFY_ON_WAITING_FOUNDER_QC=true
NEXABURST_NOTIFY_EVERY_N_SUCCESS=25
NEXABURST_NOTIFY_COOLDOWN_SECONDS=30
NEXABURST_TELEGRAM_THREAD_ID=
NEXABURST_BROWSER_MAX_AGE_SECONDS=3600
# Telegram artifact vault (separate from notifier topic).
NEXABURST_VAULT_ENABLED=false
NEXABURST_VAULT_CHAT_ID=
NEXABURST_VAULT_THREAD_ID=
# Official cloud Bot API: upload <=50MB, getFile download <=20MB.
# Defaults keep headroom for request overhead / restore verification.
NEXABURST_VAULT_MAX_UPLOAD_BYTES=49000000
NEXABURST_VAULT_MAX_RESTORE_BYTES=19500000
