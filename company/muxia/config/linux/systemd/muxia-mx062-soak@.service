[Unit]
Description=MUXIA MX-062 bounded non-production 24h soak (%i)
After=network.target

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=/srv/die/company/muxia
Environment=NODE_ENV=production
Environment=MUXIA_ROOT=/var/lib/muxia
ExecStart=@NODE_PATH@ /srv/die/company/muxia/scripts/mx062-soak.mjs --root /var/lib/muxia-soak/mx062-soak-v1 --receipt /var/lib/muxia-soak/mx062-soak-v1.receipt.json
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/die
ReadWritePaths=/var/lib/muxia-soak

[Install]
WantedBy=multi-user.target
