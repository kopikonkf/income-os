[Unit]
Description=DIE Division01 Runtime Decision MCP (Linux pre-cutover)
After=network.target
Wants=network.target

[Service]
Type=simple
User=die-division01
Group=die-runtime
WorkingDirectory=/srv/die
EnvironmentFile=/etc/die/division01/runtime-mcp.env
Environment=DIE_HOME=/srv/die
Environment=DIE_STATE_ROOT=/var/lib/die
Environment=MUXIA_ROOT=/var/lib/muxia
Environment=DIE_CONFIG_ROOT=/etc/die
Environment=DIE_INSTALL_ROOT=/opt/die
Environment=PYTHONPATH=/srv/die/bridge:/srv/die/bin
ExecStart=/usr/bin/python3 -m income_os_bridge.runtime_mcp_server --principal-id division-head-division01 --port 8792
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0007

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/srv/die
ReadWritePaths=/var/lib/die/state

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
