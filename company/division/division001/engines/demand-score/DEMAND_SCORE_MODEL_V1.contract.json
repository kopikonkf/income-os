  "scoring_policy": {
    "formula": "weighted_mean_of_known_nonrisk_components_minus_bounded_risk_penalty",
    "missing_optional": "RENORMALIZE_KNOWN_WEIGHTS_NEVER_IMPUTE_ZERO",
    "required_missing": "NO_NUMERIC_SCORE",
    "risk_penalty_multiplier": 0.15,
    "final_clamp": [
      0.0,
      1.0
    ],
    "production_gate_authority": "Demand Score alone never authorizes production; Worth-Making + Executive review + downstream authority remain required."
  },
  "weight_sum_nonrisk": 1.0,
  "required_base_weight": 0.7,
  "transform_registry": {
    "index_0_100": "value/100",
    "boolean_presence": "true=1,false=0",
    "ratio_direct": "value",
    "rank_reciprocal_10": "max(0,1-(rank-1)/9) for rank 1..10; ranks >10 => 0",
    "count_competition_log100k": "1-min(1,log10(1+count)/log10(100001))",
    "delta_minus100_plus100": "(delta+100)/200",
    "normalized_evidence_identity": "explicit normalized_value 0..1 from deterministic/canon evidence artifact",
    "count_demand_log10k": "min(1,log10(1+count)/log10(10001))"
  },
  "confidence_policy": {
    "HIGH": "all KNOWN evidence refs HIGH quality and evidence_coverage_ratio >= 0.80",
    "MEDIUM": "no LOW-quality KNOWN evidence refs and evidence_coverage_ratio >= 0.60",
    "LOW": "COMPLETE score with lower coverage/quality",
    "NONE": "non-COMPLETE score status"
  }
