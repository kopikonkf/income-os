{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethers.my.id/schemas/die-h01/h01-family-set-rights-candidate.v1.schema.json",
  "title": "DIE H01 Family/Set Rights Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "candidate_kind", "candidate_id",
    "declared_rights_class", "constituents", "evidence", "requested_route"
  ],
  "properties": {
    "schema": {"const": "die.h01.family-set-rights-candidate.v1"},
    "schema_version": {"const": "1.0.0"},
    "candidate_kind": {"enum": ["SEMANTIC_FAMILY", "DESIGN_SET"]},
    "candidate_id": {"type": "string", "minLength": 3, "maxLength": 200},
    "declared_rights_class": {
      "enum": ["GENERIC_UNRESTRICTED", "REVIEW_REQUIRED", "BRAND_RESTRICTED", "UNKNOWN"]
    },
    "constituents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref_id", "ref_kind", "rights_class", "evidence_refs"],
        "properties": {
          "ref_id": {"type": "string", "minLength": 1, "maxLength": 240},
          "ref_kind": {"enum": ["SEMANTIC_FAMILY", "CANONICAL_SEMANTIC_MEMBER"]},
          "rights_class": {
            "enum": ["GENERIC_UNRESTRICTED", "REVIEW_REQUIRED", "BRAND_RESTRICTED", "UNKNOWN"]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 500}
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "kind", "ref"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 3, "maxLength": 160},
          "kind": {
            "enum": ["OBJECT_ATLAS_RECORD", "OBJECT_ATLAS_TAXONOMY", "CANONICAL_POLICY", "RIGHTS_EVIDENCE", "CURATED_RELATION"]
          },
          "ref": {"type": "string", "minLength": 3, "maxLength": 500},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "requested_route": {"const": "NORMAL_STOCK_PRODUCTION"}
  }
}
