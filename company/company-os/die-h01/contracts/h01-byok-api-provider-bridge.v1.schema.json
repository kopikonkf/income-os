{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"die.h01.byok-api-provider-bridge.v1.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","task_id","policy","providers"],
  "properties":{
    "schema":{"const":"die.h01.byok-api-provider-bridge.v1"},
    "task_id":{"const":"H01-142"},
    "policy":{
      "type":"object","additionalProperties":false,
      "required":["browser_native_primary","browser_native_replacement_allowed","capacity_mode","scheduling_authority","direct_routing_authority","production_role_default"],
      "properties":{
        "browser_native_primary":{"const":true},
        "browser_native_replacement_allowed":{"const":false},
        "capacity_mode":{"const":"OPPORTUNISTIC_SUPPLEMENTAL_ONLY"},
        "scheduling_authority":{"const":"MISSION_CONTROL"},
        "direct_routing_authority":{"const":false},
        "production_role_default":{"const":"DISABLED"}
      }
    },
    "providers":{"type":"array","items":{"$ref":"#/$defs/provider"}}
  },
  "$defs":{
    "provider":{
      "type":"object","additionalProperties":false,
      "required":["provider_id","display_name","provider_kind","api_base_origin","connection_state","credential_reference_present","health","capabilities","production_roles"],
      "properties":{
        "provider_id":{"type":"string","minLength":1},
        "display_name":{"type":"string","minLength":1},
        "provider_kind":{"enum":["OPENAI_COMPATIBLE","ANTHROPIC_API","GEMINI_API","CUSTOM_API"]},
        "api_base_origin":{"type":"string"},
        "connection_state":{"enum":["UNCONFIGURED","CONFIGURED","DISABLED"]},
        "credential_reference_present":{"type":"boolean"},
        "health":{"type":"object","additionalProperties":false,"required":["status","observed_at"],"properties":{"status":{"enum":["UNKNOWN","HEALTHY","DEGRADED","UNHEALTHY"]},"observed_at":{"type":["string","null"]}}},
        "capabilities":{"type":"array","uniqueItems":true,"items":{"enum":["TEXT","TEXT_SVG","NATIVE_SVG","RASTER_IMAGE"]}},
        "production_roles":{"type":"object","additionalProperties":false,"required":["H01_SVG_GENERATION"],"properties":{"H01_SVG_GENERATION":{"enum":["ENABLED","DISABLED"]}}}
      }
    }
  }
}
