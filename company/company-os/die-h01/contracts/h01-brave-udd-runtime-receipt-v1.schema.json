{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"die.h01.brave-udd-runtime-receipt.v1",
  "type":"object","additionalProperties":false,
  "required":["schema","status","job_id","provider_id","profile_id","udd_id","started_at","completed_at","mode","ownership","browser","durable_result","error","safety"],
  "properties":{
    "schema":{"const":"die.h01.brave-udd-runtime-receipt.v1"},"status":{"enum":["PASS","FAIL"]},
    "job_id":{"type":"string","minLength":1},"provider_id":{"type":"string","minLength":1},
    "profile_id":{"pattern":"^h01-web-p[0-9]{3}$"},"udd_id":{"pattern":"^h01-web-s[0-9]{2}$"},
    "started_at":{"type":"string","format":"date-time"},"completed_at":{"type":"string","format":"date-time"},
    "mode":{"enum":["probe","wait-result"]},"ownership":{"type":"object"},"browser":{"type":"object"},
    "durable_result":{"type":"object"},"error":{"type":["object","null"]},"safety":{"type":"object"}
  }
}
