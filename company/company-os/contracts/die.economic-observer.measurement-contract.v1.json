                  "minor_units_preferred":  true,
                  "fx_requires_rate_timestamp_source":  true,
                  "invent_fx_rate":  false
              },
    "pnl":  {
                "net_realized_revenue":  "gross_realized_revenue - refunds - chargebacks_reversals",
                "contribution_profit":  "net_realized_revenue - direct_variable_costs - shared_variable_usage_costs",
                "cash_operating_profit":  "company_contribution_profit - global_fixed_operating_cash_costs - other_nonvariable_operating_cash_costs",
                "founder_labor_cost":  "founder_active_minutes / 60 * founder_shadow_hourly_rate",
                "economic_operating_profit":  "cash_operating_profit - founder_labor_cost - other_explicit_noncash_labor_cost"
            },
    "founder_time":  {
                         "rate_default":  "UNSET",
                         "invent_rate":  false,
