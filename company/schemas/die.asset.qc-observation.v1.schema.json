{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "die.asset.qc-observation.v1.schema.json",
  "title": "DIE Asset QC Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "asset_id", "asset_sha256", "blueprint_id", "blueprint_sha256",
    "reviewer_id", "reviewer_version", "factors"
  ],
  "properties": {
    "schema_version": {"const": "die.asset.qc-observation.v1"},
    "asset_id": {"type": "string", "minLength": 1},
    "asset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "blueprint_id": {"type": "string", "minLength": 1},
    "blueprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewer_version": {"type": "string", "minLength": 1},
    "factors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["score", "confidence", "defect_classes", "evidence_refs"],
        "properties": {
          "score": {"type": "number", "minimum": 0, "maximum": 4},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "defect_classes": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_refs": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
