{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "die.asset.qc-label.v1.schema.json",
  "title": "DIE Asset QC Founder/Manual Label v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "label_id",
    "labeled_at",
    "labeler_principal_id",
    "asset_class",
    "asset_id",
    "asset_sha256",
    "blueprint_id",
    "blueprint_sha256",
    "qa_receipt_sha256",
    "decision",
    "defect_classes",
    "rationale_summary",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "die.asset.qc-label.v1"},
    "label_id": {"type": "string", "minLength": 1},
    "labeled_at": {"type": "string", "minLength": 1},
    "labeler_principal_id": {"type": "string", "minLength": 1},
    "asset_class": {"type": "string", "minLength": 1},
    "asset_id": {"type": "string", "minLength": 1},
    "asset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "blueprint_id": {"type": "string", "minLength": 1},
    "blueprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qa_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {"enum": ["PASS", "FAIL", "REVIEW"]},
    "defect_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "rationale_summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
