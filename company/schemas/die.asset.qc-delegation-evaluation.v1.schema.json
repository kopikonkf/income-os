{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "die.asset.qc-delegation-evaluation.v1.schema.json",
  "title": "DIE Asset QC Delegation Evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "mode",
    "qc_release_authorized",
    "submission_authorized",
    "reasons"
  ],
  "properties": {
    "schema_version": {
      "const": "die.asset.qc-delegation-evaluation.v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "enum": [
        "SHADOW_ONLY",
        "CALIBRATED_RECOMMENDER",
        "BOUNDED_AUTO_QC",
        "SAMPLED_AUDIT"
      ]
    },
    "qc_release_authorized": {
      "type": "boolean"
    },
    "submission_authorized": {
      "const": false
    },
    "reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
