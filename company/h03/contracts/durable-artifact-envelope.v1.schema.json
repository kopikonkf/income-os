{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "die.h03.durable-artifact-envelope.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "holding_id", "run_id", "artifact_id", "kind", "declared_payload_schema", "producer_work_card_id", "payload"],
  "properties": {
    "schema_version": {"const": "die.h03.durable-artifact-envelope.v1"},
    "holding_id": {"const": "H03"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}$"},
    "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}$"},
    "kind": {"type": "string", "minLength": 2},
    "declared_payload_schema": {"type": "string", "minLength": 2},
    "producer_work_card_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}$"},
    "payload": {}
  }
}
