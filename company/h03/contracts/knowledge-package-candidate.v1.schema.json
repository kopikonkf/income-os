{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "die.h03.knowledge-package-candidate.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","knowledge_package_candidate_id","holding_id","knowledge_map_id","claims","source_snapshot_refs","contradictions","gaps","promotion_state","canonical_truth"],
  "properties": {
    "schema_version": {"const":"die.h03.knowledge-package-candidate.v1"},
    "knowledge_package_candidate_id": {"type":"string","minLength":6},
    "holding_id": {"const":"H03"},
    "knowledge_map_id": {"type":"string","minLength":6},
    "claims": {
      "type":"array",
      "items": {
        "type":"object","additionalProperties":false,
        "required":["claim_id","text","evidence_refs"],
        "properties":{"claim_id":{"type":"string","minLength":2},"text":{"type":"string","minLength":3},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true}}
      }
    },
    "source_snapshot_refs": {"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},
    "contradictions": {"type":"array"},
    "gaps": {"type":"array"},
    "promotion_state": {"enum":["AWAITING_SOURCE_GOVERNANCE","AWAITING_GAP_RESOLUTION","AWAITING_CONTRADICTION_RESOLUTION","ELIGIBLE_FOR_KNOWLEDGE_VALIDATION"]},
    "canonical_truth": {"const":false}
  }
}
