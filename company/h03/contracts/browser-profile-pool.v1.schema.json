{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "die.h03.browser-profile-pool.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","holding_id","pool_id","purpose","session_material_policy","shards"],
  "properties": {
    "schema_version": {"const":"die.h03.browser-profile-pool.v1"},
    "holding_id": {"const":"H03"},
    "pool_id": {"type":"string","minLength":4},
    "purpose": {"enum":["KNOWLEDGE_WORKFORCE","GROWTH_WORKFORCE"]},
    "session_material_policy": {"const":"HOST_LOCAL_NOT_PRODUCT_TRUTH"},
    "shards": {
      "type":"array","minItems":1,
      "items": {
        "type":"object","additionalProperties":false,"required":["shard_id","state","providers"],
        "properties": {
          "shard_id":{"type":"string","minLength":2},
          "state":{"enum":["READY","DEGRADED","UNAVAILABLE","UNKNOWN"]},
          "providers": {
            "type":"array",
            "items":{"type":"object","additionalProperties":false,"required":["provider_id","state","available_slots","transport_family"],"properties":{"provider_id":{"type":"string"},"state":{"enum":["READY","DEGRADED","UNAVAILABLE","AUTH_REQUIRED","RATE_LIMITED","UNKNOWN"]},"available_slots":{"type":"integer","minimum":0},"transport_family":{"enum":["SESSION_API","BROWSER_CDP","OPENAI_COMPATIBLE"]}}}
          }
        }
      }
    }
  }
}
