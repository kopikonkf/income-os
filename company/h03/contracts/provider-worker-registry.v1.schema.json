{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "die.h03.provider-worker-registry.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","holding_id","providers"],
  "properties": {
    "schema_version": {"const":"die.h03.provider-worker-registry.v1"},
    "holding_id": {"const":"H03"},
    "providers": {
      "type":"array",
      "items": {
        "type":"object","additionalProperties":false,
        "required":["provider_id","model_route","roles","capabilities","transport_families","priority"],
        "properties": {
          "provider_id":{"type":"string","minLength":2},
          "model_route":{"type":"string","minLength":2},
          "roles":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},
          "capabilities":{"type":"array","items":{"type":"string"},"uniqueItems":true},
          "transport_families":{"type":"array","minItems":1,"items":{"enum":["SESSION_API","BROWSER_CDP","OPENAI_COMPATIBLE"]},"uniqueItems":true},
          "priority":{"type":"integer","minimum":1,"maximum":1000}
        }
      }
    }
  }
}
