{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "die.h03.economic-observation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","observation_id","holding_id","observed_at","event_type","measurement_state","economic_trace_id","parent_task_id","provenance_ref","evidence_refs","payload"],
  "properties": {
    "schema_version": {"const":"die.h03.economic-observation.v1"},
    "observation_id": {"type":"string","minLength":8},
    "holding_id": {"const":"H03"},
    "observed_at": {"type":"string"},
    "event_type": {"enum":["RESOURCE_USAGE","FOUNDER_TIME","COST_DIRECT_VARIABLE"]},
    "measurement_state": {"enum":["OBSERVED","UNKNOWN"]},
    "economic_trace_id": {"type":"string","minLength":3},
    "parent_task_id": {"type":"string","minLength":3},
    "provenance_ref": {"type":"string","minLength":2},
    "evidence_refs": {"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},
    "payload": {"type":["object","null"]}
  }
}
