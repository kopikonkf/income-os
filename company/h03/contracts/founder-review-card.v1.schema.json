{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "die.h03.founder-review-card.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_card_id",
    "holding_id",
    "product_id",
    "reviewer_observation",
    "buyer",
    "problem",
    "promise",
    "product_preview",
    "evidence_confidence",
    "market_wtp_basis",
    "risk_flags",
    "rights_flags",
    "decision",
    "decision_reasons",
    "review_layer",
    "decision_authority",
    "founder_action_required",
    "external_publication_authorized"
  ],
  "properties": {
    "schema_version": {
      "const": "die.h03.founder-review-card.v1"
    },
    "review_card_id": {
      "type": "string",
      "minLength": 6
    },
    "holding_id": {
      "const": "H03"
    },
    "product_id": {
      "type": "string",
      "minLength": 3
    },
    "reviewer_observation": {
      "type": "object"
    },
    "buyer": {
      "type": "string",
      "minLength": 3
    },
    "problem": {
      "type": "string",
      "minLength": 3
    },
    "promise": {
      "type": "string",
      "minLength": 3
    },
    "product_preview": {
      "type": "object"
    },
    "evidence_confidence": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "market_wtp_basis": {
      "type": "object"
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rights_flags": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decision": {
      "enum": [
        "PASS",
        "REVISE",
        "REJECT"
      ]
    },
    "decision_reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "founder_action_required": {
      "type": "boolean"
    },
    "external_publication_authorized": {
      "const": false
    },
    "review_layer": {
      "const": "INDEPENDENT_PRE_FOUNDER_REVIEW"
    },
    "decision_authority": {
      "const": "INDEPENDENT_REVIEWER_NOT_FOUNDER"
    }
  }
}
