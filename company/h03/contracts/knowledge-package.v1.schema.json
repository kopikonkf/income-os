{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "die.h03.knowledge-package.v1",
  "type": "object",
  "required": [
    "schema_version",
    "knowledge_package_id",
    "holding_id",
    "source_packet",
    "claims",
    "rights_status",
    "version"
  ],
  "properties": {
    "schema_version": {
      "const": "die.h03.knowledge-package.v1"
    },
    "knowledge_package_id": {
      "type": "string",
      "minLength": 1
    },
    "holding_id": {
      "const": "H03"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "rights_status": {
      "enum": [
        "INTERNAL_ORIGINAL",
        "GOVERNED_EXTERNAL"
      ]
    },
    "source_packet": {
      "type": "object",
      "required": [
        "source_id",
        "rights_status",
        "evidence_units"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "rights_status": {
          "type": "string"
        },
        "evidence_units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "evidence_id",
              "text"
            ],
            "properties": {
              "evidence_id": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "text",
          "evidence_refs"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
