{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "die.h03.local-product-package.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "holding_id",
    "product_id",
    "knowledge_package_id",
    "form",
    "title",
    "pdf_file",
    "zip_file",
    "manifest_file",
    "validation_file",
    "content_batch_ids",
    "external_publication",
    "status",
    "pdf_sha256",
    "zip_sha256",
    "page_count"
  ],
  "properties": {
    "schema_version": {
      "const": "die.h03.local-product-package.v1"
    },
    "holding_id": {
      "const": "H03"
    },
    "product_id": {
      "type": "string",
      "minLength": 3
    },
    "knowledge_package_id": {
      "type": "string",
      "minLength": 3
    },
    "form": {
      "type": "string",
      "minLength": 2
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "pdf_file": {
      "type": "string",
      "minLength": 1
    },
    "zip_file": {
      "type": "string",
      "minLength": 1
    },
    "manifest_file": {
      "type": "string",
      "minLength": 1
    },
    "validation_file": {
      "type": "string",
      "minLength": 1
    },
    "content_batch_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "external_publication": {
      "const": false
    },
    "status": {
      "const": "LOCAL_SALE_READY_UNREVIEWED"
    },
    "pdf_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "zip_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "page_count": {
      "type": "integer",
      "minimum": 1
    }
  }
}
