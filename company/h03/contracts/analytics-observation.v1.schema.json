{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"die.h03.analytics-observation.v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","observation_id","holding_id","source_id","source_family","observed_at","identity","metrics","referrer","source_record_ref"],
  "properties":{
    "schema_version":{"const":"die.h03.analytics-observation.v1"},
    "observation_id":{"type":"string","minLength":6},
    "holding_id":{"const":"H03"},
    "source_id":{"type":"string","minLength":2},
    "source_family":{"enum":["MARKETPLACE","SOCIAL","HOSTED_CHECKOUT","LOCAL_LINK_COMMERCE","OWNED_WEB"]},
    "observed_at":{"type":"string","minLength":10},
    "identity":{"type":"object"},
    "metrics":{"type":"object"},
    "referrer":{"type":"object"},
    "source_record_ref":{"type":"string","minLength":3}
  }
}
