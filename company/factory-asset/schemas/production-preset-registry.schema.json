{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethers.my.id/schemas/factory-asset/production-preset-registry.v1.schema.json",
  "title": "Factory Production Preset Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "presets"
  ],
  "properties": {
    "schema": {
      "const": "die.factory-asset.production-preset-registry.v1"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/preset"
      }
    }
  },
  "$defs": {
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset_id",
        "revision",
        "status",
        "activation",
        "asset_type",
        "media_family",
        "render_language",
        "style",
        "view_defaults",
        "composition_defaults",
        "fidelity_defaults",
        "commercial_defaults",
        "prompt_descriptors",
        "negative_defaults",
        "evidence"
      ],
      "properties": {
        "preset_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{5,96}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": {
          "enum": [
            "HISTORICAL_ACCEPTED",
            "FOUNDER_DESIGN_CANDIDATE",
            "CANARY_ACCEPTED",
            "PRODUCTION_CHAMPION",
            "DEPRECATED"
          ]
        },
        "activation": {
          "enum": [
            "BASELINE_COMPATIBILITY_ONLY",
            "NOT_LIVE",
            "CANARY_ONLY",
            "LIVE_DEFAULT"
          ]
        },
        "asset_type": {
          "enum": [
            "PHOTO",
            "ISOLATED_OBJECT",
            "ICON",
            "OUTLINE",
            "PATTERN",
            "ANIMATION"
          ]
        },
        "media_family": {
          "enum": [
            "RASTER",
            "VECTOR",
            "MOTION"
          ]
        },
        "render_language": {
          "enum": [
            "ILLUSTRATION",
            "PHOTOREALISTIC",
            "THREE_D_RENDER",
            "GRAPHIC",
            "MOTION"
          ]
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "family",
            "variant",
            "medium",
            "stylization"
          ],
          "properties": {
            "family": {
              "enum": [
                "ILLUSTRATIVE_CLIPART",
                "CARTOON",
                "PHOTOREALISTIC",
                "THREE_D_RENDERED",
                "HAND_DRAWN",
                "FLAT_GRAPHIC",
                "MINIMALIST",
                "PAPER_CUT",
                "CLAY_TOY",
                "PIXEL_RETRO",
                "STYLIZED_SEMI_ABSTRACT"
              ]
            },
            "variant": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_-]{2,96}$"
            },
            "medium": {
              "enum": [
                "DIGITAL_ILLUSTRATION",
                "WATERCOLOR",
                "GOUACHE",
                "COLORED_PENCIL",
                "CRAYON",
                "INK",
                "PASTEL",
                "MARKER",
                "CEL_RENDER",
                "VECTOR_LIKE",
                "THREE_D",
                "PHOTOGRAPHIC"
              ]
            },
            "stylization": {
              "enum": [
                "VERY_LOW",
                "LOW",
                "LOW_MEDIUM",
                "MEDIUM",
                "MEDIUM_HIGH",
                "HIGH"
              ]
            }
          }
        },
        "view_defaults": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "viewpoint"
          ],
          "properties": {
            "viewpoint": {
              "enum": [
                "SUBJECT_APPROPRIATE",
                "FRONT",
                "THREE_QUARTER",
                "TOP_DOWN",
                "SIDE",
                "ISOMETRIC"
              ]
            }
          }
        },
        "composition_defaults": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "background_mode",
            "allowed_background_modes",
            "centered",
            "full_subject_visible",
            "generous_whitespace",
            "clean_silhouette",
            "unrelated_props"
          ],
          "properties": {
            "background_mode": {
              "enum": [
                "TRANSPARENT",
                "PURE_WHITE",
                "SOLID_NEUTRAL"
              ]
            },
            "allowed_background_modes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "TRANSPARENT",
                  "PURE_WHITE",
                  "SOLID_NEUTRAL"
                ]
              }
            },
            "centered": {
              "type": "boolean"
            },
            "full_subject_visible": {
              "type": "boolean"
            },
            "generous_whitespace": {
              "type": "boolean"
            },
            "clean_silhouette": {
              "type": "boolean"
            },
            "unrelated_props": {
              "type": "boolean"
            }
          }
        },
        "fidelity_defaults": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proportions",
            "recognizability",
            "texture_detail",
            "color_behavior",
            "edge_character",
            "shading"
          ],
          "properties": {
            "proportions": {
              "enum": [
                "REALISTIC",
                "NATURAL_RECOGNIZABLE",
                "STYLIZED_RECOGNIZABLE"
              ]
            },
            "recognizability": {
              "enum": [
                "HIGH",
                "VERY_HIGH"
              ]
            },
            "texture_detail": {
              "enum": [
                "LOW",
                "LIGHT",
                "MODERATE",
                "DETAILED"
              ]
            },
            "color_behavior": {
              "enum": [
                "NATURAL",
                "VIBRANT_REALISTIC",
                "FRIENDLY_STYLIZED",
                "MUTED"
              ]
            },
            "edge_character": {
              "enum": [
                "CRISP_CLEAN",
                "SOFT_HAND_PAINTED",
                "SMOOTH_VECTOR_LIKE",
                "NATURAL_PHOTOGRAPHIC"
              ]
            },
            "shading": {
              "enum": [
                "NONE",
                "SUBTLE",
                "GENTLE",
                "NATURAL",
                "DETAILED"
              ]
            }
          }
        },
        "commercial_defaults": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stock_asset_quality",
            "reusable_design_component",
            "subject_separation"
          ],
          "properties": {
            "stock_asset_quality": {
              "const": true
            },
            "reusable_design_component": {
              "const": true
            },
            "subject_separation": {
              "enum": [
                "CLEAR",
                "VERY_CLEAR"
              ]
            }
          }
        },
        "prompt_descriptors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 180
          }
        },
        "negative_defaults": {
          "type": "array",
          "minItems": 3,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "refs"
          ],
          "properties": {
            "basis": {
              "enum": [
                "HISTORICAL_ACCEPTANCE",
                "FOUNDER_SPECIFIED_DIRECTION",
                "CANARY_EVIDENCE"
              ]
            },
            "refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 3,
                "maxLength": 240
              }
            }
          }
        }
      }
    }
  }
}
