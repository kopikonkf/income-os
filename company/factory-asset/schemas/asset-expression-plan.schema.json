{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethers.my.id/schemas/factory-asset/asset-expression-plan.v1.schema.json",
  "title": "Factory Asset Expression Plan v1",
  "description": "Pre-blueprint semantic decisions. Validate cross-references with validate_asset_expression_plan; this contract grants no production or submission authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_id",
    "seed",
    "decision",
    "decision_rationale",
    "policy",
    "evidence",
    "expressions"
  ],
  "properties": {
    "schema": {
      "const": "die.factory-asset.asset-expression-plan.v1"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^FAEP-[A-Z0-9][A-Z0-9_-]{5,63}$"
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed_id",
        "noun"
      ],
      "properties": {
        "seed_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "noun": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160,
          "pattern": "\\S"
        }
      }
    },
    "decision": {
      "enum": [
        "SELECT",
        "RESEARCH",
        "REJECT"
      ]
    },
    "decision_rationale": {
      "type": "string",
      "minLength": 16,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expansion_rule",
        "force_all_modes",
        "packaging_variants_create_new_semantic_asset",
        "derivative_planning_stage",
        "submission_authority"
      ],
      "properties": {
        "expansion_rule": {
          "const": "EVIDENCE_SUPPORTED_ONLY"
        },
        "force_all_modes": {
          "const": false
        },
        "packaging_variants_create_new_semantic_asset": {
          "const": false
        },
        "derivative_planning_stage": {
          "const": "AFTER_VALIDATED_MASTER"
        },
        "submission_authority": {
          "const": "FOUNDER_CONTROLLED"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "expressions": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/expression"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "SELECT"
          }
        }
      },
      "then": {
        "properties": {
          "expressions": {
            "minItems": 1
          },
          "evidence": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "expressions": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed_noun",
        "buyer",
        "commercial_use_case",
        "product_expression",
        "semantic_mode",
        "platform_id"
      ],
      "properties": {
        "seed_noun": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "buyer": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240,
          "pattern": "\\S"
        },
        "commercial_use_case": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240,
          "pattern": "\\S"
        },
        "product_expression": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240,
          "pattern": "\\S"
        },
        "semantic_mode": {
          "enum": [
            "PHOTO",
            "ISOLATED_OBJECT",
            "ICON",
            "OUTLINE",
            "PATTERN",
            "ANIMATION"
          ]
        },
        "platform_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_-]{1,63}$"
        }
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_asset_id",
        "buyer",
        "commercial_use_case",
        "product_expression",
        "semantic_mode",
        "producer_class",
        "candidate_marketplace_route",
        "evidence_refs",
        "selection_rationale"
      ],
      "properties": {
        "semantic_asset_id": {
          "type": "string",
          "pattern": "^FASA-[A-Z0-9][A-Z0-9_-]{5,63}$"
        },
        "buyer": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240,
          "pattern": "\\S"
        },
        "commercial_use_case": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240,
          "pattern": "\\S"
        },
        "product_expression": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240,
          "pattern": "\\S"
        },
        "semantic_mode": {
          "enum": [
            "PHOTO",
            "ISOLATED_OBJECT",
            "ICON",
            "OUTLINE",
            "PATTERN",
            "ANIMATION"
          ]
        },
        "producer_class": {
          "enum": [
            "RASTER_GENERATIVE",
            "NATIVE_VECTOR",
            "PROCEDURAL_VECTOR",
            "MOTION_RENDERER"
          ]
        },
        "candidate_marketplace_route": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform_id",
            "listing_use",
            "state"
          ],
          "properties": {
            "platform_id": {
              "type": "string",
              "pattern": "^[A-Z0-9][A-Z0-9_-]{1,63}$"
            },
            "listing_use": {
              "type": "string",
              "minLength": 8,
              "maxLength": 240,
              "pattern": "\\S"
            },
            "state": {
              "const": "CANDIDATE_REQUIRES_POLICY_CHECK"
            }
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S"
          }
        },
        "selection_rationale": {
          "type": "string",
          "minLength": 16,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "temporal_value": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "temporal_verb",
            "visual_change",
            "buyer_utility"
          ],
          "properties": {
            "temporal_verb": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80,
              "pattern": "\\S"
            },
            "visual_change": {
              "type": "string",
              "minLength": 16,
              "maxLength": 500,
              "pattern": "\\S"
            },
            "buyer_utility": {
              "type": "string",
              "minLength": 16,
              "maxLength": 500,
              "pattern": "\\S"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "semantic_mode": {
                "enum": [
                  "PHOTO",
                  "ISOLATED_OBJECT"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "producer_class": {
                "enum": [
                  "RASTER_GENERATIVE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "semantic_mode": {
                "enum": [
                  "ICON",
                  "OUTLINE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "producer_class": {
                "enum": [
                  "NATIVE_VECTOR",
                  "PROCEDURAL_VECTOR"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "semantic_mode": {
                "enum": [
                  "PATTERN"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "producer_class": {
                "enum": [
                  "PROCEDURAL_VECTOR"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "semantic_mode": {
                "enum": [
                  "ANIMATION"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "producer_class": {
                "enum": [
                  "MOTION_RENDERER"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "semantic_mode": {
                "const": "ANIMATION"
              }
            }
          },
          "then": {
            "required": [
              "temporal_value"
            ]
          },
          "else": {
            "not": {
              "required": [
                "temporal_value"
              ]
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "kind",
        "source_ref",
        "source_sha256",
        "support",
        "rationale"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "BUYER_BRIEF",
            "MARKET_OBSERVATION",
            "APPROVED_RESEARCH",
            "SYNTHETIC_FIXTURE",
            "OBJECT_ATLAS_SEED"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "support": {
          "$ref": "#/$defs/scope"
        },
        "rationale": {
          "type": "string",
          "minLength": 16,
          "maxLength": 500,
          "pattern": "\\S"
        }
      }
    }
  }
}
