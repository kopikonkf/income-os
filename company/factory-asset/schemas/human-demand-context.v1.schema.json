{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethers.my.id/schemas/factory-asset/human-demand-context.v1.schema.json",
  "title": "Human Demand Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "context_id",
    "human",
    "activity",
    "place",
    "time",
    "demographic",
    "emotion",
    "problem",
    "industry",
    "commercial_intent",
    "use_case",
    "object_hints",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "die.factory-asset.human-demand-context.v1"
    },
    "context_id": {
      "type": "string",
      "pattern": "^HDC-[A-Z0-9][A-Z0-9_-]{5,80}$"
    },
    "human": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "activity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "place": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "time": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "demographic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "emotion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "problem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "industry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "commercial_intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "use_case": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "object_hints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 160
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "refs",
        "inherited_demand_allowed"
      ],
      "properties": {
        "label": {
          "enum": [
            "CANON_EXAMPLE_ONLY",
            "OBSERVED_SIGNAL",
            "RESEARCH_HYPOTHESIS"
          ]
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          }
        },
        "inherited_demand_allowed": {
          "const": false
        }
      }
    }
  }
}
