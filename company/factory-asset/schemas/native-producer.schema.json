{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aethers.my.id/schemas/factory-asset/native-producer.v1.schema.json",
  "title":"Factory Asset Native Producer Contract v1",
  "oneOf":[{"$ref":"#/$defs/request"},{"$ref":"#/$defs/receipt"}],
  "$defs":{
    "producer_class":{"enum":["PROCEDURAL_VECTOR","MOTION_RENDERER","LAYERED_TEMPLATE","THREE_D_RENDERER"]},
    "request":{"type":"object","additionalProperties":false,"required":["schema","kind","job_id","idempotency_key","blueprint_id","semantic_asset_id","producer_class","producer_version","parameters","cancellation"],"properties":{"schema":{"const":"die.factory-asset.native-producer.v1"},"kind":{"const":"REQUEST"},"job_id":{"type":"string","minLength":8},"idempotency_key":{"type":"string","pattern":"^[a-f0-9]{64}$"},"blueprint_id":{"type":"string","pattern":"^FABP-[A-Z0-9][A-Z0-9_-]{5,63}$"},"semantic_asset_id":{"type":"string","pattern":"^FASA-[A-Z0-9][A-Z0-9_-]{5,63}$"},"producer_class":{"$ref":"#/$defs/producer_class"},"producer_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"parameters":{"type":"object"},"cancellation":{"type":"object","additionalProperties":false,"required":["token","poll_or_signal_supported"],"properties":{"token":{"type":"string","minLength":8},"poll_or_signal_supported":{"const":true}}}}},
    "master":{"type":"object","additionalProperties":false,"required":["format","sha256","bytes","native_editable","generated_by_native_producer","conversion_from_raster","lineage_sha256_required"],"properties":{"format":{"enum":["SVG","EPS","MP4","MOV","PSD","AIT","INDT","PPTX","GLB","GLTF","OBJ","FBX"]},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"bytes":{"type":"integer","minimum":1},"native_editable":{"const":true},"generated_by_native_producer":{"const":true},"conversion_from_raster":{"const":false},"lineage_sha256_required":{"const":true}}},
    "failure":{"type":"object","additionalProperties":false,"required":["code","retryable"],"properties":{"code":{"enum":["INVALID_INPUT","UNSUPPORTED_COMBINATION","PRODUCER_UNAVAILABLE","RENDER_FAILED","CANCELLED","TIMEOUT","OUTPUT_VALIDATION_FAILED"]},"retryable":{"type":"boolean"},"message":{"type":"string","maxLength":500}}},
    "receipt":{"type":"object","additionalProperties":false,"required":["schema","kind","job_id","idempotency_key","producer_class","producer_version","result","deterministic_receipt_sha256"],"properties":{"schema":{"const":"die.factory-asset.native-producer.v1"},"kind":{"const":"RECEIPT"},"job_id":{"type":"string","minLength":8},"idempotency_key":{"type":"string","pattern":"^[a-f0-9]{64}$"},"producer_class":{"$ref":"#/$defs/producer_class"},"producer_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"result":{"enum":["PASS","FAIL","CANCELLED"]},"master":{"$ref":"#/$defs/master"},"failure":{"$ref":"#/$defs/failure"},"deterministic_receipt_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"allOf":[{"if":{"properties":{"result":{"const":"PASS"}},"required":["result"]},"then":{"required":["master"],"not":{"required":["failure"]}}},{"if":{"properties":{"result":{"enum":["FAIL","CANCELLED"]}},"required":["result"]},"then":{"required":["failure"],"not":{"required":["master"]}}}]}
  }
}