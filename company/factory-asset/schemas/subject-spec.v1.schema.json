{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethers.my.id/schemas/factory-asset/subject-spec.v1.schema.json",
  "title": "Factory Subject Specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "subject_spec_id",
    "seed_id",
    "canonical_name",
    "subject_class",
    "primary_form",
    "essential_components",
    "recognition_anchors",
    "natural_attributes",
    "spatial_relationships",
    "forbidden_subject_mutations",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "die.factory-asset.subject-spec.v1"
    },
    "subject_spec_id": {
      "type": "string",
      "pattern": "^FASS-[A-Z0-9][A-Z0-9_-]{5,80}$"
    },
    "seed_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^SEED-[0-9]{6}$"
    },
    "canonical_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    },
    "subject_class": {
      "enum": [
        "SIMPLE_OBJECT",
        "PREPARED_FOOD",
        "PLANT",
        "ANIMAL",
        "TOOL",
        "CONTAINER",
        "FURNITURE",
        "VEHICLE",
        "DECOR",
        "OTHER"
      ]
    },
    "primary_form": {
      "type": "string",
      "minLength": 8,
      "maxLength": 1000
    },
    "essential_components": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "placement"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "minLength": 2,
            "maxLength": 400
          },
          "placement": {
            "type": "string",
            "minLength": 2,
            "maxLength": 300
          }
        }
      }
    },
    "recognition_anchors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 240
      }
    },
    "natural_attributes": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 240
      }
    },
    "spatial_relationships": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 300
      }
    },
    "forbidden_subject_mutations": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 240
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "refs"
      ],
      "properties": {
        "basis": {
          "enum": [
            "FOUNDER_SPECIFIED",
            "OBJECT_ATLAS_PLUS_COGNITION",
            "REFERENCE_DERIVED",
            "MANUAL_CANON"
          ]
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          }
        }
      }
    }
  }
}
