{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aethers.my.id/schemas/factory-asset/image-provider.v1.schema.json",
  "title":"Factory Asset Image Provider Contract v1",
  "oneOf":[{"$ref":"#/$defs/capability"},{"$ref":"#/$defs/generate_request"},{"$ref":"#/$defs/generate_result"},{"$ref":"#/$defs/health"}],
  "$defs":{
    "provider_id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{1,31}$"},
    "transport":{"enum":["SESSION_API","BROWSER_CDP","HYBRID","OFFICIAL_API"]},
    "capability":{"type":"object","additionalProperties":false,"required":["schema","kind","provider_id","contract_version","transport_classes","image_generation","output_formats","capacity_state"],"properties":{"schema":{"const":"die.factory-asset.image-provider.v1"},"kind":{"const":"CAPABILITY"},"provider_id":{"$ref":"#/$defs/provider_id"},"contract_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"transport_classes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/transport"}},"image_generation":{"const":true},"output_formats":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["PNG","JPEG","WEBP"]}},"supports_transparency":{"enum":["YES","NO","UNKNOWN"]},"supports_requested_dimensions":{"enum":["YES","NO","UNKNOWN"]},"capacity_state":{"enum":["UNKNOWN","AVAILABLE","CONSTRAINED","UNAVAILABLE"]}}},
    "generate_request":{"type":"object","additionalProperties":false,"required":["schema","kind","job_id","idempotency_key","blueprint_id","semantic_asset_id","prompt","requested_output","deadline_seconds"],"properties":{"schema":{"const":"die.factory-asset.image-provider.v1"},"kind":{"const":"GENERATE_REQUEST"},"job_id":{"type":"string","minLength":8},"idempotency_key":{"type":"string","pattern":"^[a-f0-9]{64}$"},"blueprint_id":{"type":"string","pattern":"^FABP-[A-Z0-9][A-Z0-9_-]{5,63}$"},"semantic_asset_id":{"type":"string","pattern":"^FASA-[A-Z0-9][A-Z0-9_-]{5,63}$"},"prompt":{"type":"string","minLength":1,"maxLength":12000},"requested_output":{"type":"object","additionalProperties":false,"required":["format"],"properties":{"format":{"enum":["PNG","JPEG","WEBP"]},"width_px":{"type":"integer","minimum":1},"height_px":{"type":"integer","minimum":1},"alpha":{"enum":["REQUIRED","FORBIDDEN","OPTIONAL"]}}},"deadline_seconds":{"type":"integer","minimum":1,"maximum":900}}},
    "artifact":{"type":"object","additionalProperties":false,"required":["sha256","bytes","mime","width_px","height_px","decode_reopen","provider_original_bytes","durable_local_save"],"properties":{"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"bytes":{"type":"integer","minimum":1},"mime":{"enum":["image/png","image/jpeg","image/webp"]},"width_px":{"type":"integer","minimum":1},"height_px":{"type":"integer","minimum":1},"decode_reopen":{"const":true},"provider_original_bytes":{"const":true},"durable_local_save":{"const":true}}},
    "failure":{"type":"object","additionalProperties":false,"required":["code","retryable"],"properties":{"code":{"enum":["AUTH_REQUIRED","CAPACITY_UNAVAILABLE","RATE_LIMITED","PROTECTION_CHALLENGE","PROVIDER_TIMEOUT","PROVIDER_ERROR","OUTPUT_NOT_FOUND","OUTPUT_VALIDATION_FAILED","POLICY_BLOCKED","UNSUPPORTED_REQUEST"]},"retryable":{"type":"boolean"},"message":{"type":"string","maxLength":500}}},
    "generate_result":{"type":"object","additionalProperties":false,"required":["schema","kind","job_id","provider_id","transport_class","result","operator_actions_after_dispatch"],"properties":{"schema":{"const":"die.factory-asset.image-provider.v1"},"kind":{"const":"GENERATE_RESULT"},"job_id":{"type":"string","minLength":8},"provider_id":{"$ref":"#/$defs/provider_id"},"transport_class":{"$ref":"#/$defs/transport"},"result":{"enum":["PASS","FAIL"]},"operator_actions_after_dispatch":{"type":"integer","minimum":0},"artifact":{"$ref":"#/$defs/artifact"},"failure":{"$ref":"#/$defs/failure"}},"allOf":[{"if":{"properties":{"result":{"const":"PASS"}},"required":["result"]},"then":{"required":["artifact"],"properties":{"operator_actions_after_dispatch":{"const":0}},"not":{"required":["failure"]}}},{"if":{"properties":{"result":{"const":"FAIL"}},"required":["result"]},"then":{"required":["failure"],"not":{"required":["artifact"]}}}]},
    "health":{"type":"object","additionalProperties":false,"required":["schema","kind","provider_id","state","observed_at","operator_action_required"],"properties":{"schema":{"const":"die.factory-asset.image-provider.v1"},"kind":{"const":"HEALTH"},"provider_id":{"$ref":"#/$defs/provider_id"},"state":{"enum":["READY","AUTH_REQUIRED","CAPACITY_UNAVAILABLE","DEGRADED","OFFLINE","POLICY_BLOCKED"]},"observed_at":{"type":"string","format":"date-time"},"operator_action_required":{"type":"boolean"},"reason_code":{"type":["string","null"]}}}
  }
}