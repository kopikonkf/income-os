[Unit]
Description=Founder temporary interactive VNC repair for Factory Cluster A
Requires=die-muxia-cluster-a-browser.service
After=die-muxia-cluster-a-browser.service
JoinsNamespaceOf=die-muxia-cluster-a-browser.service

[Service]
Type=simple
User=kopiko
Group=kopiko
WorkingDirectory=/opt/die/factory-asset-observability
ExecStart=/usr/bin/bash /opt/die/factory-asset-observability/founder_vnc_view.sh --cluster-id cluster-a --display 101 --port 59201 --mode interactive
Restart=no
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
