{
  "schema": "die.factory-asset.multi-cluster-scheduler-contract.v1",
  "revision": "1.0.0",
  "task_id": "FA-306",
  "status": "CANONICAL_CANDIDATE",
  "job_identity": {
    "queue_lease_key": "job_id + idempotency_key",
    "generation_commit_uniqueness": "job_id",
    "idempotency_conflict_action": "FAIL_CLOSED",
    "duplicate_commit_action": "FAIL_CLOSED"
  },
  "queue_leases": {
    "default_ttl_ms": 300000,
    "cross_cluster_exclusive": true,
    "provider_tab_lease_still_required_for_browser_routes": true,
    "expired_uncommitted_lease": "EXPLICIT_RECLAIM_REQUIRED",
    "committed_lease_auto_reclaim_allowed": false
  },
  "fairness": {
    "scope": "HEALTHY_ELIGIBLE_CLUSTERS",
    "policy": "LEAST_SELECTED_CLUSTER_PRIORITY_PENALTY",
    "does_not_override": ["READINESS", "CAPACITY", "POLICY", "TAB_LIMITS", "CIRCUIT_OPEN"]
  },
  "circuit_breakers": {
    "provider_cluster_failure_threshold": 2,
    "cluster_failure_threshold": 3,
    "default_cooldown_ms": 300000,
    "pre_dispatch_failures_only_for_reroute": true,
    "post_dispatch_retry_allowed": false,
    "cooldown_expiry_recloses_without_secret_or_provider_probe": true
  },
  "retry": {
    "max_retries": 2,
    "retry_event_idempotent": true,
    "post_dispatch_retry_allowed": false
  },
  "authority": {
    "provider_generation_calls": false,
    "browser_owner_actions": false,
    "secret_reads": false,
    "spend_usd": 0,
    "submission_authorized": false,
    "publication_authorized": false
  }
}