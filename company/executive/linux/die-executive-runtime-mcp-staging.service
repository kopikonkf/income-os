[Unit]
Description=DIE Executive Runtime Decision MCP (Linux staging read-only)
After=network.target
Wants=network.target

[Service]
Type=simple
User=die-executive
Group=die-runtime
WorkingDirectory=/opt/die/staging/income-os
EnvironmentFile=/etc/die/staging/executive/runtime-mcp.env
Environment=DIE_HOME=/opt/die/staging/income-os
Environment=DIE_STATE_ROOT=/var/lib/die
Environment=MUXIA_ROOT=/var/lib/muxia
Environment=DIE_CONFIG_ROOT=/etc/die
Environment=DIE_INSTALL_ROOT=/opt/die
Environment=PYTHONPATH=/opt/die/staging/income-os/bridge:/opt/die/staging/income-os/bin
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m income_os_bridge.runtime_mcp_server --principal-id die-lnx-executive-001 --port 8891
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/opt/die/staging/income-os /var/lib/die/state

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
